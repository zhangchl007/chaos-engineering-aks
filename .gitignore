# Local .terraform directories
**/.terraform/*
/local-state/
/cosmos-account-import.tf

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log

# Keep real environment inputs local; commit only redacted examples.

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do wish to add to version control using negated pattern
#
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

*.tfplan
*plan.json
*.plan
devplan
prodplan
*.tfstate.lock.info
**/*kubeconfig*
.env
.env.*
*.auto.tfvars
*.private.tfvars
*.private.tfvars.json
*.private.json
/.venv/
*.tfvars
!*.example.tfvars
*.tfvars.json
!*.example.tfvars.json

# Private keys, credential stores and local authentication files
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
credentials
credentials.json
.secrets
.secrets.*

*.pyc
*.lock.hcl
!**/.terraform.lock.hcl
