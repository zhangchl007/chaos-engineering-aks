# Copy outside the repository and fill in the approved existing backend.
# The key is a Blob path, not a storage access key.
resource_group_name  = "<backend-resource-group>"
storage_account_name = "<backend-storage-account>"
container_name       = "<backend-container>"
key                  = "dev/platform.tfstate"
subscription_id      = "<backend-subscription-id>"
tenant_id            = "<backend-tenant-id>"
use_azuread_auth     = true
