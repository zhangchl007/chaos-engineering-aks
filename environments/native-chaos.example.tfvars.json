{
  "subscription_id": "<subscription-id>",
  "tenant_id": "<tenant-id>",
  "resource_group_id": "<approved-test-resource-group-id>",
  "location": "<supported-workspace-region>",
  "name": "<workspace-name>",
  "enabled": true,
  "scopes": ["<approved-test-resource-group-id>", "<approved-aks-node-resource-group-id>"],
  "allow_destructive_configuration": false,
  "excluded_resource_ids": ["<excluded-system-vmss-id>", "<excluded-recovery-vm-id>"],
  "scenarios": {
    "m01-mysql-ha-failover": {
      "description": "M-01 native HA failover; configuration is not execution authorization.",
      "action_id": "microsoft-mysql-failover/1.0",
      "target_ids": ["<mysql-resource-id>"],
      "parameters": {"RestoreOnStop": "false"},
      "duration_minutes": 1
    },
    "m02-mysql-restart": {
      "description": "M-02 native restart.",
      "action_id": "microsoft-mysql-restart/1.0",
      "target_ids": ["<mysql-resource-id>"],
      "parameters": {},
      "duration_minutes": 1
    },
    "p01-postgresql-planned-failover": {
      "description": "P-01 planned failover.",
      "action_id": "microsoft-azurepostgresql-failover/1.0",
      "target_ids": ["<postgresql-resource-id>"],
      "parameters": {"FailoverMode": "PlannedFailover", "RestoreOnStop": "false", "SkipIneligibleServers": "false"},
      "duration_minutes": 1
    },
    "p02-postgresql-forced-failover": {
      "description": "P-02 forced failover; requires separate risk and recovery authorization.",
      "action_id": "microsoft-azurepostgresql-failover/1.0",
      "target_ids": ["<postgresql-resource-id>"],
      "parameters": {"FailoverMode": "ForcedFailover", "RestoreOnStop": "false", "SkipIneligibleServers": "false"},
      "duration_minutes": 1
    },
    "r01-legacy-redis-primary-reboot": {
      "description": "R-01 legacy Redis primary reboot, not Managed Redis.",
      "action_id": "microsoft-azureclusteredcacheforredis-reboot/1.0",
      "target_ids": ["<legacy-redis-resource-id>"],
      "parameters": {"RebootType": "PrimaryNode"},
      "duration_minutes": 1
    },
    "r02-legacy-redis-secondary-reboot": {
      "description": "R-02 legacy Redis secondary reboot.",
      "action_id": "microsoft-azureclusteredcacheforredis-reboot/1.0",
      "target_ids": ["<legacy-redis-resource-id>"],
      "parameters": {"RebootType": "SecondaryNode"},
      "duration_minutes": 1
    },
    "b01-servicebus-send-disabled": {
      "description": "B-01 disable sending on one existing approved queue.",
      "action_id": "microsoft-servicebus-changequeuestate/1.0",
      "target_ids": ["<service-bus-namespace-id>"],
      "parameters": {"desiredState": "SendDisabled", "queues": "[\"<approved-queue-name>\"]"},
      "duration_minutes": 1
    },
    "b02-servicebus-receive-disabled": {
      "description": "B-02 disable receiving on one existing approved queue.",
      "action_id": "microsoft-servicebus-changequeuestate/1.0",
      "target_ids": ["<service-bus-namespace-id>"],
      "parameters": {"desiredState": "ReceiveDisabled", "queues": "[\"<approved-queue-name>\"]"},
      "duration_minutes": 1
    },
    "h01-eventhub-send-disabled": {
      "description": "H-01 disable sending on one existing approved hub.",
      "action_id": "microsoft-eventhub-changeeventhubstate/1.0",
      "target_ids": ["<event-hubs-namespace-id>"],
      "parameters": {"desiredState": "SendDisabled", "eventhubs": "[\"<approved-hub-name>\"]"},
      "duration_minutes": 1
    },
    "h02-eventhub-disabled": {
      "description": "H-02 disable one existing approved hub.",
      "action_id": "microsoft-eventhub-changeeventhubstate/1.0",
      "target_ids": ["<event-hubs-namespace-id>"],
      "parameters": {"desiredState": "Disabled", "eventhubs": "[\"<approved-hub-name>\"]"},
      "duration_minutes": 1
    },
    "v09-private-vm-restart": {
      "description": "V-09 private broker VM restart; guest and recovery qualification required.",
      "action_id": "microsoft-compute-restart/1.0",
      "target_ids": ["<approved-private-vm-id>"],
      "parameters": {},
      "duration_minutes": 1
    },
    "n07-single-user-node-shutdown": {
      "description": "N-07 one verified User-pool instance; exclude System and recovery resources.",
      "action_id": "microsoft-virtualmachinescaleset-shutdown/1.0",
      "target_ids": ["<approved-user-vmss-id>"],
      "parameters": {"GracefulShutdown": "true", "Zones": "[\"<verified-single-instance-zone>\"]"},
      "duration_minutes": 1,
      "locations": ["<actual-user-vmss-region>"],
      "zones": ["<verified-single-instance-zone>"]
    }
  },
  "permissions": {
    "mysql": {
      "target_id": "<mysql-resource-id>",
      "actions": ["Microsoft.DBforMySQL/flexibleServers/failover/action", "Microsoft.DBforMySQL/flexibleServers/read", "Microsoft.DBforMySQL/flexibleServers/restart/action"]
    },
    "postgresql": {
      "target_id": "<postgresql-resource-id>",
      "actions": ["Microsoft.DBforPostgreSQL/flexibleServers/read", "Microsoft.DBforPostgreSQL/flexibleServers/restart/action"]
    },
    "legacy_redis": {
      "target_id": "<legacy-redis-resource-id>",
      "actions": ["Microsoft.Cache/redis/forcereboot/action", "Microsoft.Cache/redis/read"]
    },
    "service_bus": {
      "target_id": "<service-bus-namespace-id>",
      "actions": ["Microsoft.ServiceBus/namespaces/queues/read", "Microsoft.ServiceBus/namespaces/queues/write", "Microsoft.ServiceBus/namespaces/read"]
    },
    "event_hubs": {
      "target_id": "<event-hubs-namespace-id>",
      "actions": ["Microsoft.EventHub/namespaces/eventhubs/read", "Microsoft.EventHub/namespaces/eventhubs/write", "Microsoft.EventHub/namespaces/read"]
    },
    "rocketmq_vm": {
      "target_id": "<approved-private-vm-id>",
      "actions": ["Microsoft.Compute/locations/operations/read", "Microsoft.Compute/virtualMachines/read", "Microsoft.Compute/virtualMachines/restart/action"]
    },
    "aks_user_vmss": {
      "target_id": "<approved-user-vmss-id>",
      "actions": ["Microsoft.Compute/virtualMachineScaleSets/poweroff/action", "Microsoft.Compute/virtualMachineScaleSets/start/action", "Microsoft.Compute/virtualMachineScaleSets/instanceView/read", "Microsoft.Compute/virtualMachineScaleSets/read", "Microsoft.Compute/locations/operations/read", "Microsoft.Compute/virtualMachines/powerOff/action", "Microsoft.Compute/virtualMachines/start/action", "Microsoft.Compute/virtualMachines/instanceView/read", "Microsoft.Compute/virtualMachines/read"]
    }
  }
}
